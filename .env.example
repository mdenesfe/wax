# Copy to .env (git-ignored) and load with: set -a; source .env; set +a
WAX_DATABASE_URL=postgres://wax:wax@127.0.0.1:5433/wax?sslmode=disable
# Generate once with: openssl rand -base64 32
# Losing this key makes every stored session unreadable (new QR needed).
WAX_MASTER_KEY=
# Integration tests (go test) use a separate database:
WAX_TEST_DATABASE_URL=postgres://wax:wax@127.0.0.1:5433/wax_test?sslmode=disable
